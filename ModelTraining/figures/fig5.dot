digraph G {
  rankdir=LR; nodesep=0.25;
  graph [fontname="Liberation Sans", bgcolor="white", nodesep=0.35, ranksep=0.38, pad=0.15, splines=ortho];
  node  [shape=box, style="filled,rounded", fillcolor="#e8eefb", color="#8c9ac0", fontname="Liberation Sans", fontsize=12, penwidth=1.1, margin="0.14,0.07", fontcolor="#1d2433"];
  edge  [color="#55627a", arrowsize=0.6, penwidth=1.0, fontname="Liberation Sans", fontsize=10, fontcolor="#55627a"];
  a [label="Window's item_emb\n(date order)", fillcolor="#f4f5f7", color="#b3b7c0"];
  r [label="Centered rating", fillcolor="#f4f5f7", color="#b3b7c0"];
  l [label="Linear"];
  p [shape=circle, label="+", width=0.3, height=0.3, fixedsize=true, fillcolor="white", color="#8c9ac0", fontsize=14, margin=0];
  g [label="GRU\n(starts from zero\nin every window)"];
  s [label="Final state\nof each window"];
  o [label="w_1 … w_K\n+ missing-window mask", fillcolor="#dff3ea", color="#7fb59c"];
  r -> l -> p; a -> p; p -> g -> s -> o;
}

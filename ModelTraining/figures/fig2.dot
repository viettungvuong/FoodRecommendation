digraph G {
  rankdir=TB;
  graph [fontname="Liberation Sans", bgcolor="white", nodesep=0.35, ranksep=0.38, pad=0.15, splines=ortho];
  node  [shape=box, style="filled,rounded", fillcolor="#e8eefb", color="#8c9ac0", fontname="Liberation Sans", fontsize=12, penwidth=1.1, margin="0.14,0.07", fontcolor="#1d2433"];
  edge  [color="#55627a", arrowsize=0.6, penwidth=1.0, fontname="Liberation Sans", fontsize=10, fontcolor="#55627a"];
  cand  [label="Candidate recipe", fillcolor="#f4f5f7", color="#b3b7c0"];
  hist  [label="History windows\n(recipes + ratings)", fillcolor="#f4f5f7", color="#b3b7c0"];
  stats [label="Avg price + nutrients\nbefore t", fillcolor="#f4f5f7", color="#b3b7c0"];
  item  [label="ItemEncoder\n(shared, each recipe encoded once)"];
  cemb  [label="Candidate item_emb"];
  henc  [label="HistoryEncoder\n(GRU per window)"];
  uenc  [label="UserEncoder\n(MLP)"];
  keys  [label="Concatenate\n[U_profile, w_1 … w_K]"];
  xatt  [label="Cross-attention\n(query = candidate item_emb)"];
  head  [label="Head: MLP over\nconcat(attn_out, item_emb)"];
  out   [label="sigmoid(logit) = P(positive)", fillcolor="#dff3ea", color="#7fb59c"];
  {rank=same; cand; hist; stats;}
  {rank=same; cemb; henc; uenc;}
  cand -> item; hist -> item;
  item -> cemb; item -> henc;
  stats -> uenc;
  henc -> keys; uenc -> keys;
  cemb -> xatt; keys -> xatt;
  xatt -> head; cemb -> head;
  head -> out;
}
